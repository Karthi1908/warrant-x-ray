  "components": {
    "schemas": {
      "ChatTurnRequest": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id",
            "description": "Client-side session UUID"
          },
          "message": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Message",
            "description": "User prompt text"
          },
          "mode": {
            "type": "string",
            "title": "Mode",
            "description": "'chat' or 'deep'",
            "default": "chat"
          },
          "snapshot_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Snapshot Id",
            "description": "Optional target snapshot ID"
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "message"
        ],
        "title": "ChatTurnRequest",
        "description": "Chat turn request payload."
      },
      "CompareRequest": {
        "properties": {
          "codes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 3,
            "minItems": 2,
            "title": "Codes",
            "description": "2 to 3 warrant codes"
          },
          "holding_days": {
            "type": "integer",
            "maximum": 365.0,
            "minimum": 1.0,
            "title": "Holding Days",
            "default": 5
          }
        },
        "type": "object",
        "required": [
          "codes"
        ],
        "title": "CompareRequest",
        "description": "Request payload for comparing warrants."
      },
      "ExplainMoveRequest": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "from_snapshot_id": {
            "type": "integer",
            "title": "From Snapshot Id"
          },
          "to_snapshot_id": {
            "type": "integer",
            "title": "To Snapshot Id"
          }
        },
        "type": "object",
        "required": [
          "code",
          "from_snapshot_id",
          "to_snapshot_id"
        ],
        "title": "ExplainMoveRequest",
        "description": "Request payload for mid price change attribution."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MetaResponse": {
        "properties": {
          "version": {
            "type": "string",
            "title": "Version",
            "default": "0.1.0"
          },
          "mode": {
            "type": "string",
            "title": "Mode",
            "description": "Operational mode: live, replay, sample"
          },
          "as_of": {
            "type": "string",
            "title": "As Of",
            "description": "UTC timestamp of current market data"
          },
          "staleness_seconds": {
            "type": "integer",
            "title": "Staleness Seconds",
            "default": 0
          },
          "last_collection_status": {
            "type": "string",
            "title": "Last Collection Status",
            "default": "ok"
          },
          "resolved_model_ids": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Resolved Model Ids"
          },
          "tier_health": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Tier Health"
          },
          "usage_metrics": {
            "$ref": "#/components/schemas/PublicUsageMetrics"
          }
        },
        "type": "object",
        "required": [
          "mode",
          "as_of"
        ],
        "title": "MetaResponse",
        "description": "System metadata response."
      },
      "PublicUsageMetrics": {
        "properties": {
          "visits": {
