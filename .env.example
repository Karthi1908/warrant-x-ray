# ==============================================================================
# Warrant X-Ray Environment Configuration (.env.example)
# Do NOT put real secrets in this file. Copy to .env and configure values.
# ==============================================================================

# Nebius Token Factory (NVIDIA Nemotron Models)
WX_NEBIUS_API_KEY=
WX_NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Tavily Search API
WX_TAVILY_API_KEY=
WX_TAVILY_DAILY_CREDITS=200

# Bursa Data Source & Collector
WX_MIBB_BASE_URL=
WX_SOURCE_ENABLED=true

# Database & Storage
WX_DB_URL=sqlite+aiosqlite:///data/warrantx.db

# Quant & Flags
WX_RISK_FREE_RATE=0.03

# Guardrails, Rate Limits & Budget Caps
WX_LLM_DAILY_USD_CAP=10.0
WX_RATE_LIMIT_CHAT_PER_HOUR=30
WX_TURN_TIMEOUT_S=60

# Experiments & Optional Features (Defaults: false)
WX_STREAM_DRAFT=false
WX_FEATURE_CHATTER=false
WX_TAVILY_RESEARCH=false
WX_TAVILY_CRAWL=false

# Administration & Security
WX_ADMIN_TOKEN=
WX_SESSION_SECRET=

# Logging & Testing
WX_LOG_LEVEL=INFO
WX_LLM_STUB=false
